# ── Env-Vorlage für den selbst gehosteten Supabase-Stack ─────────────────
#
# NIEMALS mit echten Werten committen. Die echten Werte gehören in die
# Coolify-Env-Verwaltung (bzw. in eine .env NEBEN docker-compose.yml, die
# per .gitignore ausgeschlossen ist).
#
# Wie die Secrets erzeugt werden: docs/self-hosting.md, Abschnitt „Secrets".

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# openssl rand -base64 36 (keine Sonderzeichen, die in URLs quoten müssten)
POSTGRES_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────
# Mindestens 32 Zeichen. Aus DIESEM Secret werden ANON_KEY und
# SERVICE_ROLE_KEY signiert — passen sie nicht zusammen, antwortet die API
# auf jede Anfrage mit 401.
JWT_SECRET=
JWT_EXPIRY=3600
# HS256-signierte JWTs mit role=anon bzw. role=service_role
ANON_KEY=
SERVICE_ROLE_KEY=

# ── URLs ─────────────────────────────────────────────────────────────────
# Origin der Supabase-API von außen (= NEXT_PUBLIC_SUPABASE_URL der App).
API_EXTERNAL_URL=https://sb.bordkasse.dieter.ms
SUPABASE_PUBLIC_URL=https://sb.bordkasse.dieter.ms
# Origin der App. Die Magic-Link-Mail baut daraus {{ .SiteURL }}/auth/confirm.
SITE_URL=https://bordkasse.dieter.ms
# Komma-Liste erlaubter Redirect-Ziele nach dem Login. Bewusst eng halten:
# jeder Eintrag ist ein möglicher Absprungpunkt für einen Auth-Redirect.
ADDITIONAL_REDIRECT_URLS=https://bordkasse.dieter.ms/auth/callback,https://bordkasse.dieter.ms/auth/confirm

# ── Signup ───────────────────────────────────────────────────────────────
# false: GoTrue legt bei signInWithOtp neue auth.users an. Das BRAUCHT die
# App — lib/auth/invite.ts lädt Crew per shouldCreateUser:true ein.
# Der Schutz gegen Fremde ist die Whitelist im App-Layer
# (isEmailAllowedToSignIn), nicht diese Flag.
DISABLE_SIGNUP=false

# ── SMTP (derselbe Mailserver wie die App-Mails) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Bordkasse

# ── E-Mail-Template ──────────────────────────────────────────────────────
# Selbst gehostetes GoTrue liest Templates NUR per HTTP-URL. Die App liefert
# das gebrandete Template aus public/email/ aus.
#
# Solange die App noch auf Vercel läuft (PR 1), MUSS hier die öffentliche URL
# stehen — der Auth-Container kann eine Vercel-App nicht über das Docker-Netz
# erreichen. Nach dem App-Umzug (PR 2) kann optional auf den internen Namen
# gewechselt werden (http://bordkasse-app:3000/email/magic-link.html), dann
# ist der Abruf unabhängig von DNS, TLS und Reverse-Proxy.
MAILER_TEMPLATE_MAGIC_LINK=https://bordkasse.dieter.ms/email/magic-link.html
MAILER_SUBJECT_MAGIC_LINK=Dein Bordkasse-Login
MAILER_URLPATHS_INVITE=/auth/confirm
MAILER_URLPATHS_CONFIRMATION=/auth/confirm
MAILER_URLPATHS_RECOVERY=/auth/confirm
MAILER_URLPATHS_EMAIL_CHANGE=/auth/confirm

# ── PostgREST ────────────────────────────────────────────────────────────
# Muss zu supabase/config.toml passen ([api] schemas / extra_search_path).
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

# ── Realtime ─────────────────────────────────────────────────────────────
# openssl rand -base64 48
SECRET_KEY_BASE=
# Genau 16 Zeichen (AES-128)
REALTIME_DB_ENC_KEY=

# ── Studio / Meta ────────────────────────────────────────────────────────
# openssl rand -hex 16
PG_META_CRYPTO_KEY=
STUDIO_DEFAULT_ORGANIZATION=Bordkasse
STUDIO_DEFAULT_PROJECT=Bordkasse
# Basic-Auth vor Studio — der einzige Schutz vor vollem DB-Zugriff an RLS
# vorbei. Langes Zufallspasswort, nirgends sonst verwendet.
# Leer lassen ist sicher: kong-entrypoint.sh verriegelt die Studio-Route dann
# mit einem Zufallspasswort (Studio unerreichbar, Rest des Gateways läuft).
# Nur ausfüllen, wenn Studio per `--profile studio` wirklich genutzt wird.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
